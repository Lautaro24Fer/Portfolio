---
import TerminalHeaderIcon from "../../icons/TerminalHeaderIcon.astro"
---

<header id="site-header" class="z-50 flex h-16 items-center justify-between px-8 sm:px-24 text-white">
  <a href="/#presentation-section" aria-label="Home" class="shrink-0 text-white/90 transition-opacity hover:opacity-100">
    <TerminalHeaderIcon />
  </a>

  <nav id="primary-navigation" aria-label="Primary">
    <ul class="nav-list">
      <li class="nav-item"><a href="/#presentation-section">Presentation</a></li>
      <li class="nav-item"><a href="/#habilities-section">Skills</a></li>
      <li class="nav-item"><a href="/#proyects-section">Work</a></li>
      <li class="nav-item"><a href="/#formation-section">Formation</a></li>
    </ul>
  </nav>

  <button
    type="button"
    class="menu-toggle"
    id="menubtn"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="primary-navigation"
  >
    <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" width="1.4em" height="1.4em">
      <path d="M3 6h18M3 12h18M3 18h18" />
    </svg>
    <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" width="1.4em" height="1.4em">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</header>
<script is:inline>
  document?.addEventListener('astro:page-load', () => {
    const headerEl = document?.querySelector('#site-header');
    const menuButton = document?.querySelector('#menubtn');
    const optionsBoard = document?.querySelector('#primary-navigation');
    const navLinks = optionsBoard ? Array.from(optionsBoard.querySelectorAll('a')) : [];

    const updateStickyState = () => {
      if (window.scrollY > 100) {
        headerEl?.classList.add('stickyPosition');
      } else {
        headerEl?.classList.remove('stickyPosition');
      }
    };

    window.addEventListener('scroll', updateStickyState);

    const isMenuOpen = () => optionsBoard?.classList.contains('isEnter') ?? false;

    const openMenu = () => {
      headerEl?.classList.remove('stickyPosition');
      optionsBoard?.classList.add('isEnter');
      menuButton?.setAttribute('aria-expanded', 'true');
      menuButton?.setAttribute('aria-label', 'Close menu');
      document.body.style.overflowY = 'hidden';
      document.documentElement.style.overflowY = 'hidden';
      navLinks[0]?.focus();
    };

    const closeMenu = ({ returnFocus = true } = {}) => {
      optionsBoard?.classList.remove('isEnter');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Open menu');
      document.body.style.overflowY = 'auto';
      document.documentElement.style.overflowY = 'auto';
      updateStickyState();
      if (returnFocus) {
        menuButton?.focus();
      }
    };

    menuButton?.addEventListener('click', () => {
      isMenuOpen() ? closeMenu() : openMenu();
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => closeMenu({ returnFocus: false }));
    });

    document.addEventListener('click', (event) => {
      if (!isMenuOpen()) return;
      const target = event.target;
      if (optionsBoard?.contains(target) || menuButton?.contains(target)) return;
      closeMenu({ returnFocus: false });
    });

    optionsBoard?.addEventListener('keydown', (event) => {
      if (!isMenuOpen()) return;

      if (event.key === 'Escape') {
        closeMenu();
        return;
      }

      if (event.key !== 'Tab' || navLinks.length === 0) return;

      const first = navLinks[0];
      const last = navLinks[navLinks.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  })
</script>
<style>
  #site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    border-bottom: 1px solid transparent;
    transition: background-color .25s ease, backdrop-filter .25s ease, border-color .25s ease;
  }

  #site-header.stickyPosition {
    position: fixed;
    background-color: rgba(2, 6, 23, .75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(255, 255, 255, .08);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: .25rem;
    list-style: none;
  }

  .nav-item a {
    display: inline-flex;
    align-items: center;
    padding: .5rem .75rem;
    border-radius: .5rem;
    font-size: .875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, .7);
    transition: color .15s ease, background-color .15s ease;
  }

  .nav-item a:hover,
  .nav-item a:focus-visible {
    color: #fff;
    background-color: rgba(255, 255, 255, .08);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .5rem;
    color: #fff;
    transition: background-color .15s ease;
  }

  .menu-toggle:hover {
    background-color: rgba(255, 255, 255, .08);
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  @media (width < 1024px) {
    .menu-toggle {
      display: inline-flex;
    }

    #primary-navigation {
      position: fixed;
      top: 4rem;
      left: 0;
      right: 0;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      background-color: rgba(2, 6, 23, .97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, .08);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-.5rem);
      transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s;
    }

    #primary-navigation.isEnter {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity .2s ease, transform .2s ease;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: .5rem;
    }

    .nav-item {
      border-bottom: 1px solid rgba(255, 255, 255, .06);
    }

    .nav-item:last-child {
      border-bottom: none;
    }

    .nav-item a {
      display: block;
      padding: .875rem 1rem;
      border-radius: .5rem;
      font-size: 1rem;
    }
  }
</style>
