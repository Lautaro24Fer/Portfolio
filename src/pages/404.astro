---
import Layout from "../layouts/Layout.astro";

const { pathname } = Astro.url;

let reference = pathname;

if (reference.length > 16) {
  reference = reference.slice(0, 16) + "...";
}
---

<Layout title="LF | 404" description="Page not found">
  <main class="min-h-screen w-full flex flex-col items-center justify-center gap-4 text-center px-4">
    <h1 class="text-white font-bold text-8xl glow-text">404</h1>
    <p class="text-gray-200 text-lg">Oops! The page {reference} doesn't exist.</p>
    <a href="/" class="text-white underline hover:no-underline">Let's get you back home.</a>
  </main>
</Layout>
