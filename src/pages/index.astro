---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Formation from "../components/sections/Formation.astro";
import Tech from "../components/sections/Tech.astro"
import Footer from "../components/sections/Footer.astro";
import Work from "../components/sections/Work.astro";
---

<Layout title="LF | Portfolio">
  <main class="sm:px-24 px-[2rem] pb-[20rem] relative sm:pt-5 pt-[1rem] h-max " id="presentation-section">
    <Header />
    <section class="w-full flex pt-[9rem] pb-[4rem] justify-center lg:justify-start">
      <section class="lg:w-[50%] w-full sm:w-full flex flex-col gap-7" >
        <h1 class="text-white font-bold md:text-7xl sm:text-5xl text-[3rem] sm:text-left text-center glow-text">
          Lautaro Leonel Fernández
        </h1>
        <h2 class="text-white md:text-4xl sm:text-3xl text-[1.5rem] sm:text-left text-center pt-[1rem] font-bold">Full Stack Developer</h2>
        <p class="text-gray-200 sm:text-left text-center">
          I am a young Argentine who, in recent years, has sought to stand out
          in the web sector with my technical skills, experience in real and
          academic projects, and university education to secure a place in the
          industry. Always ready to learn and work with the team.
        </p>
        <section class="flex gap-8 z-10">
          <a id="see-in-gh-btn" href="https://github.com/Lautaro24Fer/Portfolio" target="_blank" rel="noopener noreferrer">
            See portfolio in GitHub
          </a>
        </section>
      </section>
    </section>
    <Tech />
    <Work />
    <Formation />
    <Footer />
  </main>
</Layout>
<style is:global>
  nav ul li {
    cursor: pointer;
  }
  /* From Uiverse.io by portseif */
a#see-in-gh-btn {
  align-items: center;
  background-color: transparent;
  color: #fff;
  cursor: pointer;
  display: flex;
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.5;
  text-decoration: none;
  text-transform: uppercase;
  outline: 0;
  border: 0;
  padding: 1rem 1rem 1rem 0;
}

a#see-in-gh-btn:before {
  background-color: #fff;
  content: "";
  display: inline-block;
  height: 1px;
  margin-right: 10px;
  transition: all .42s cubic-bezier(.25,.8,.25,1);
  width: 0;
}

a#see-in-gh-btn:hover:before {
  background-color: #fff;
  width: 3rem;
}
</style>
